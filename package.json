{
  "private": true,
  "devDependencies": {
    "typescript": "5.1.3",
    "@types/three": "0.153.0",
    "sass": "1.65.1",
    "concurrently": "8.2.0",
    "vinyl-fs": "4.0.0",
    "@types/vinyl-fs": "3.0.4",
    "ts-node": "10.9.1",
    "dotenv": "16.3.1",
    "electron": "27.0.4",
    "electron-builder": "24.6.4"
  },
  "name": "starmap",
  "version": "0.9.0",
  "main": "app/index.js",
  "dependencies": {
    "three": "^0.154.0"
  },
  "scripts": {
    "watch": "concurrently -n web,app,sass \"npx tsc --project src/web/tsconfig.json --watch --pretty --preserveWatchOutput\" \"npx tsc --project src/app/tsconfig.json --watch --pretty --preserveWatchOutput\" \"npx sass scss/index.scss out/index.css --watch\"",
    "build": "concurrently -n web,app,sass \"npx tsc --project src/web/tsconfig.json --pretty\" \"npx tsc --project src/app/tsconfig.json --pretty\" \"npx sass scss/index.scss out/index.css\"",
    "app": "npx electron .",
    "buildapp": "npx electron-builder build",
    "strippro": "npx ts-node tasks/StripPro.ts"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "build": {
    "appId": "works.luminamystere.starmap",
    "productName": "starmap",
    "copyright": "Copyright © 2023 Lumina Mystere",
    "files": [
      "package.json",
      "app/",
      "out/",
      "index.html",
      "static/",
      "node_modules/three/",
      {
        "from": "no-more-defaults"
      },
      "node_modules/three/examples/"
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ]
    }
  }
}